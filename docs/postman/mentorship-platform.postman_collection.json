{
  "info": {
    "name": "Mentorship Platform",
    "description": "Manual API testing for the Mentorship Platform.\n\nRun the requests top to bottom: the auth requests capture their JWT into collection variables, so every later request is already authorised. Booking captures its id and the mentor's id the same way.\n\nPrerequisites:\n  docker compose up -d\n  ./mvnw spring-boot:run\n\nThe server must be reachable at {{baseUrl}} (default http://localhost:8081).\n\nWebSocket chat is not covered here - Postman's STOMP support is limited, and ChatWebSocketIntegrationTest exercises it properly. See docs/API.md for the WebSocket contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "mentorToken", "value": "" },
    { "key": "candidateToken", "value": "" },
    { "key": "mentorId", "value": "" },
    { "key": "availabilityId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register mentor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('mentorToken', body.token);",
                  "pm.test('returns a bearer token', () => pm.expect(body.tokenType).to.eql('Bearer'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grace Hopper\",\n  \"email\": \"grace.mentor@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"MENTOR\"\n}"
            }
          }
        },
        {
          "name": "Register candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('candidateToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada.candidate@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CANDIDATE\"\n}"
            }
          }
        },
        {
          "name": "Register duplicate email (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Again\",\n  \"email\": \"ada.candidate@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CANDIDATE\"\n}"
            }
          }
        },
        {
          "name": "Login candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('candidateToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada.candidate@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login wrong password (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada.candidate@example.com\",\n  \"password\": \"wrong-password\"\n}"
            }
          }
        },
        {
          "name": "Current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Current user without token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Mentor profile and discovery",
      "item": [
        {
          "name": "Create mentor profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('mentorId', pm.response.json().mentorId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/mentors/profile", "host": ["{{baseUrl}}"], "path": ["api", "mentors", "profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"industry\": \"FinTech\",\n  \"expertise\": \"Java\",\n  \"experience\": 8,\n  \"bio\": \"Backend systems and distributed architecture.\"\n}"
            }
          }
        },
        {
          "name": "Candidate cannot create a mentor profile (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{candidateToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/mentors/profile", "host": ["{{baseUrl}}"], "path": ["api", "mentors", "profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"industry\": \"FinTech\",\n  \"expertise\": \"Java\",\n  \"experience\": 3,\n  \"bio\": \"Should be rejected.\"\n}"
            }
          }
        },
        {
          "name": "Search mentors (filters + pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('paged response', () => pm.expect(pm.response.json()).to.have.property('totalElements'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/mentors?industry=FinTech&expertise=Java&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mentors"],
              "query": [
                { "key": "industry", "value": "FinTech" },
                { "key": "expertise", "value": "Java" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "View mentor profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/mentors/{{mentorId}}", "host": ["{{baseUrl}}"], "path": ["api", "mentors", "{{mentorId}}"] }
          }
        },
        {
          "name": "Own profile (mentor)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{mentorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/mentors/profile", "host": ["{{baseUrl}}"], "path": ["api", "mentors", "profile"] }
          }
        },
        {
          "name": "Update mentor profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/mentors/profile", "host": ["{{baseUrl}}"], "path": ["api", "mentors", "profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"industry\": \"FinTech\",\n  \"expertise\": \"Java, Kotlin\",\n  \"experience\": 9,\n  \"bio\": \"Updated bio.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Availability",
      "item": [
        {
          "name": "Create availability slot",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A slot must start in the future; this one starts in 1 hour.",
                  "const start = new Date(Date.now() + 60 * 60 * 1000);",
                  "const end = new Date(start.getTime() + 60 * 60 * 1000);",
                  "pm.collectionVariables.set('slotStart', start.toISOString());",
                  "pm.collectionVariables.set('slotEnd', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('availabilityId', pm.response.json().id);",
                  "pm.test('starts AVAILABLE', () => pm.expect(pm.response.json().status).to.eql('AVAILABLE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/availability", "host": ["{{baseUrl}}"], "path": ["api", "availability"] },
            "body": { "mode": "raw", "raw": "{\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\"\n}" }
          }
        },
        {
          "name": "Overlapping slot (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/availability", "host": ["{{baseUrl}}"], "path": ["api", "availability"] },
            "body": { "mode": "raw", "raw": "{\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\"\n}" }
          }
        },
        {
          "name": "Invalid range (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/availability", "host": ["{{baseUrl}}"], "path": ["api", "availability"] },
            "body": { "mode": "raw", "raw": "{\n  \"startTime\": \"{{slotEnd}}\",\n  \"endTime\": \"{{slotStart}}\"\n}" }
          }
        },
        {
          "name": "Mentor's own slots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{mentorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/availability", "host": ["{{baseUrl}}"], "path": ["api", "availability"] }
          }
        },
        {
          "name": "Public availability for a mentor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/mentors/{{mentorId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mentors", "{{mentorId}}", "availability"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Booking",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', body.id);",
                  "pm.test('CONFIRMED', () => pm.expect(body.status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{candidateToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] },
            "body": { "mode": "raw", "raw": "{\n  \"availabilityId\": {{availabilityId}}\n}" }
          }
        },
        {
          "name": "Double booking the same slot (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict - slot already taken', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{candidateToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] },
            "body": { "mode": "raw", "raw": "{\n  \"availabilityId\": {{availabilityId}}\n}" }
          }
        },
        {
          "name": "List my bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Unknown booking (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/99999999", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "99999999"] }
          }
        },
        {
          "name": "Cancel booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Session chat history",
      "item": [
        {
          "name": "Session transcript",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Set sessionId manually: a session is created with each booking.",
                  "// Live chat itself runs over WebSocket - see docs/API.md."
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "messages"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Health",
      "item": [
        {
          "name": "Health check (no auth)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    }
  ]
}
